{
  "expo": {
    "name": "PawPass",
    "slug": "pawpass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": [
      "pawpass",
      "clerk"
    ],
    "splash": {
      "image": "./assets/pawpass-logo-2026-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#080F08"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.stodghillconsulting.pawpass",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PawPass uses your location to find nearby businesses, parks, events, and community-reviewed places.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PawPass uses your location to find nearby businesses, parks, events, and community-reviewed places.",
        "NSPhotoLibraryUsageDescription": "PawPass accesses your photo library to attach photos to reviews, access reports, business profiles, and verification submissions.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "clerk",
            "CFBundleURLSchemes": [
              "pawpass"
            ]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.stodghillconsulting.pawpass",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon/foreground.png",
        "backgroundImage": "./assets/adaptive-icon/background.png",
        "backgroundColor": "#080F08"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pawpass411.com",
              "pathPrefix": "/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://pawpass411.com",
      "clerkPublishableKey": "",
      "stripePublishableKey": "",
      "router": {},
      "eas": {
        "projectId": "6a74d89d-0638-417f-a095-7e3f77af7da2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PawPass uses your location to find nearby businesses, parks, events, and community-reviewed places."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PawPass accesses your photos to attach images to reviews, reports, business profiles, and verification submissions.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#AAFF00",
          "sounds": []
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "pawpass411"
  }
}
