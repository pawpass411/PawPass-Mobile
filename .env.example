# PawPass Mobile — Environment Variables
# Copy to .env.local for local development
# Production values are set as EAS secrets in the Expo dashboard

# ── API ───────────────────────────────────────────────────────
# URL of the Next.js backend (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://pawpass411.com

# ── AUTH (Clerk) ──────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── PAYMENTS (Stripe) ─────────────────────────────────────────
# Publishable key only — never put secret key in mobile app
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── APP ENVIRONMENT ───────────────────────────────────────────
# "development" | "preview" | "production"
EXPO_PUBLIC_APP_ENV=development

# Show reviewer demo accounts on sign-in screen?
# Set to "true" for App Store / Play Store review builds
# Automatically true when APP_ENV != "production"
EXPO_PUBLIC_SHOW_DEMO=true
